# Pasons Smart QR - environment template
#
# Copy to .env and fill in the values. .env is gitignored; this template
# is committed so every machine knows which variables exist.
#
# The AI review-assist provider order is MiMo > DeepSeek > Gemini.
# With every key left blank, the composer still works: it tidies the
# guest's own words on-device (no invented sentences).

# --- AI review assist - Xiaomi MiMo (preferred) --------------------------
# MiMo is tried on two endpoints in order: the main API (MIMO_BASE_URL),
# then the token-plan endpoint (MIMO_TOKEN_PLAN_URL). Either key alone
# enables MiMo; use MIMO_TOKEN_PLAN_API_KEY for a dedicated token-plan key.
MIMO_API_KEY=
MIMO_TOKEN_PLAN_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# --- AI review assist - DeepSeek (fallback) -----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- AI review assist - Google Gemini (fallback) ------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Django --------------------------------------------------------------
SECRET_KEY=django-insecure-dev-only-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (production only; SQLite is used when POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
