# Pasons Smart QR - environment template
#
# Copy to .env and fill in the values. .env is gitignored; this template
# is committed so every machine knows which variables exist.
#
# The AI review-assist provider order is MiMo > DeepSeek > Gemini.
# With every key left blank, the composer still works: it tidies the
# guest's own words on-device (no invented sentences).

# --- AI review assist - Xiaomi MiMo (preferred) --------------------------
# MiMo is tried on two endpoints in order: the main API (MIMO_BASE_URL),
# then the token-plan endpoint (MIMO_TOKEN_PLAN_URL). Either key alone
# enables MiMo; use MIMO_TOKEN_PLAN_API_KEY for a dedicated token-plan key.
MIMO_API_KEY=
MIMO_TOKEN_PLAN_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# --- AI review assist - DeepSeek (fallback) -----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- AI review assist - Google Gemini (fallback) ------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Django --------------------------------------------------------------
SECRET_KEY=django-insecure-dev-only-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Sharing the dev server through a tunnel (optional) ------------------
# With DEBUG=1 the common tunnel domains are already trusted by wildcard
# (ngrok-free.app, ngrok-free.dev, ngrok.io, ngrok.app, trycloudflare.com,
# loca.lt), so a fresh random ngrok URL works with no config change.
# Override the suffix list only if you use a different tunnel provider:
#TUNNEL_HOST_SUFFIXES=ngrok-free.app,trycloudflare.com
# Extra exact hosts, added on top of ALLOWED_HOSTS:
#ALLOWED_HOSTS_EXTRA=mybox.local,192.168.1.20
# Extra trusted CSRF origins (scheme is required):
#CSRF_TRUSTED_ORIGINS=https://mybox.local
# With DEBUG=0 none of the tunnel wildcards apply; list real hosts explicitly.

# --- PostgreSQL (production only; SQLite is used when POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Guest identity: Google sign-in (apps/guests) ------------------------
# Google Cloud -> APIs and Services -> Credentials -> OAuth 2.0 Client ID,
# application type "Web application". Add these Authorised JavaScript
# origins: http://127.0.0.1:8000, http://localhost:8000 and the real domain.
# The client id is PUBLIC (it ships in the page). With it blank, the guest
# sheet hides the Google button and the name + mobile form still works.
GOOGLE_CLIENT_ID=
# Not needed for the ID-token flow we use; kept for a future code exchange.
GOOGLE_CLIENT_SECRET=
