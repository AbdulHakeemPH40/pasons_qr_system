# Pasons Smart QR - production environment template.
#
# This file is a reference, not a secret. The real .env is written on the
# server by deploy/bootstrap.sh (fresh SECRET_KEY and database password) and
# never leaves that machine.
#
# Django -------------------------------------------------------------------
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=qr-system.pasons.group
# Both schemes while the certificate is being installed; the https entry is the
# one that matters once certbot has run. A missing origin makes every POST fail
# with a 403 CSRF mismatch, including the panel login.
CSRF_TRUSTED_ORIGINS=https://qr-system.pasons.group,http://qr-system.pasons.group
# The address printed QR codes and exports point at. Never localhost in
# production: a table-tent QR must open the live site.
PUBLIC_BASE_URL=https://qr-system.pasons.group
SERVE_MEDIA=0
USE_X_FORWARDED_PROTO=0

# HTTPS: enable only once a certificate is installed and https:// works.
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
# The guest identity cookie follows SESSION_COOKIE_SECURE by default, so the
# two move together. Only set this to override that.
#GUEST_COOKIE_SECURE=0

# PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=pasons
POSTGRES_USER=pasons
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# AI review assist (blank falls back to local tidying) ---------------------
MIMO_API_KEY=
MIMO_TOKEN_PLAN_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Guest Google sign-in (optional) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Guest WhatsApp one time code -------------------------------------------
# The guest sheet proves a mobile number with a six digit code. All six of
# these must be filled or the check REFUSES to send: it never falls back to
# printing the code on screen, because that would let anyone verify any
# number. The dashboard procedure is in Docs/WHATSAPP_OTP_SETUP.md, section A.
#
#   ACCESS_TOKEN    Business Settings > Users > System users > Generate new
#                   token. Permissions whatsapp_business_messaging and
#                   whatsapp_business_management. Expiry Never. Shown once.
#   PHONE_NUMBER_ID WhatsApp Manager > Account tools > Phone numbers, from
#                   the number's own details. NOT the phone number itself.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE=pasons_otp
WHATSAPP_OTP_LANGUAGE=en
WHATSAPP_TIMEOUT_SECONDS=10
# Must stay 0 in production. 1 logs the code and returns it to the browser.
WHATSAPP_OTP_DEBUG=0
# Reference only, the code does not read it.
WHATSAPP_APP_ID=

