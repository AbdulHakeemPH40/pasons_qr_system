# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
Docs/panel_accounts.md
Docs/panel_accounts.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtualenv
venv/
.venv/
Docs/

# Local runserver output
server.log

# Local ngrok tunnel output
ngrok.log

# Local database — not part of the repo
db.sqlite3
db.sqlite3-journal

# Test-run media uploads (regenerated by the test suite)
media/brands/test-logo_*.png
media/menu/pdf/menu_*.pdf
media/menu/pdf/menu.pdf
media/menu/specials/*_???????.jpg

# Dish photos uploaded through the panel at runtime. Seeded copies that are
# already tracked stay tracked; new uploads never enter the repository.
media/menu/items/dish_*.png

# Menu PDFs uploaded through the panel at runtime. Django renames them with an
# `own` prefix and a random suffix, so every manager upload would otherwise
# appear in `git status` forever.
media/menu/pdf/own*.pdf

# Local screen recordings and scratch output
*.mp4
paired-output.txt

# Local recovery holding (deleted files kept for restore, never shipped)
.trash/

# Collected static (regenerated by collectstatic)
staticfiles/

# Optimised image derivatives (regenerated by `manage.py optimize_media`).
# Generated binary artifacts, ~2.9 MB: never commit them, and never hand-edit.
# Run the command after deploy or after adding images.
media/deriv/

# IDE / agent tooling, not part of the Django project
.cortex/
.playwright-mcp/
.idea/
.vscode/

# Design deliverables and generators, kept local
Pasons_Smart_QR_Prototype/
design_prototype_svg/
sketch_schemas/
*.pptx
generate_deck.py
generate_prototype_svg.py
generate_sketch.py
verify_deck.py
verify_prototype_svg.py
/app.html
/app.css
/tokens.css

# Spec and plan documents, kept local
*.md

# Exception: the vendored games must ship their licence and attribution docs.
# CREDITS.md and the per-game CHANGES.md files record every modification, and
# each folder keeps its upstream licence file. Re-include the docs so the
# vendored games stay licence-compliant inside the repository.
!static/games/vendor/**/*.md
