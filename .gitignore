staticfiles/

# IDE / agent tooling, not part of the Django project
.cortex/
.playwright-mcp/
.idea/
.vscode/

# Design deliverables and generators, kept local
Pasons_Smart_QR_Prototype/
design_prototype_svg/
sketch_schemas/
*.pptx
generate_deck.py
generate_prototype_svg.py
generate_sketch.py
verify_deck.py
verify_prototype_svg.py
/app.html
/app.css
/tokens.css

# Spec and plan documents, kept local
*.md

# Exception: the vendored games must ship their licence and attribution docs.
# Hextris is GPL-3.0 and its licence text lives in LICENSE.md; CREDITS.md and
# the per-game CHANGES.md files record every modification. Re-include them so
# the vendored games stay licence-compliant inside the repository.
!static/games/vendor/**/*.md
